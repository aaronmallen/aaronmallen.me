#!/usr/bin/env sh
#MISE description="Run tests for the project"
#MISE alias=["t"]
#USAGE arg "[filter]..." var=#true help="Feature files or Playwright options, such as --workers 2."

set -e

if ! scripts/util/check_libvips; then
  echo "Ruby cannot load libvips. Run \`mise run setup:dependencies\` to install it." >&2
  exit 1
fi

exec scripts/test/features "$@"
