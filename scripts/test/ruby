#!/usr/bin/env sh
#MISE description="Run the ruby tests across every core without building assets"
#MISE alias=["t:rb", "test:rb"]
#USAGE arg "[filter]..." var=#true help="Spec files, directories, file:line pairs or rspec options. Runs the whole suite and records its runtimes when empty. A file:line pair runs in one process."

set -e

scripts/test/prepare
rm -f coverage/.resultset.json

for arg; do
  case "$arg" in
  *_spec.rb:* | *_spec.rb\[*)
    exec scripts/util/ensure_postgres bundle exec rspec --require spec_helper "$@"
    ;;
  esac
done

log=""
if [ $# -eq 0 ]; then
  log="--format ParallelTests::RSpec::RuntimeLogger --out log/parallel_runtime_rspec.log"
fi

files=""
for arg; do
  shift
  if [ -e "$arg" ]; then
    files="$files $arg"
  else
    set -- "$@" "$arg"
  fi
done

# shellcheck disable=SC2086
exec scripts/util/ensure_postgres bundle exec parallel_rspec --runtime-log log/parallel_runtime_rspec.log -- --require spec_helper --format progress $log "$@" -- ${files:-spec}
