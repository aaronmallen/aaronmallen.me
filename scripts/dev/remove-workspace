#!/usr/bin/env sh
#MISE description="Drop a workspace's test database, forget the workspace and delete its directory"
#USAGE arg "<id>" help="The number the workspace was created with"

set -e

id="$1"
dir="$(scripts/util/workspace "$id")"

HANAMI_ENV="test" WORKSPACE_ID="$id" scripts/db/drop
jj workspace forget "ws${id}"
rm -rf "$dir"
