#!/usr/bin/env sh
#MISE description="Give the newest commit that is not empty an annotated tag named for the next CalVer version"
#USAGE flag "--dry-run" help="Print the version, the commit, its CI state and the variables .env.example gained since the last tag, and make no tag"
#USAGE flag "--skip-ci" help="Tag even when CI has not passed on the commit, for an emergency"
#USAGE arg "[date]" help="The date that names the version, as YYYY-MM-DD. Defaults to today in UTC."

set -e

dry_run=""
skip_ci=""
on=""
for arg; do
  case "$arg" in
  --dry-run) dry_run=1 ;;
  --skip-ci) skip_ci=1 ;;
  *) on="$arg" ;;
  esac
done
on="${on:-$(date -u +%Y-%m-%d)}"

case "$on" in
[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) ;;
*)
  echo "Give the date as YYYY-MM-DD, not $on." >&2
  exit 1
  ;;
esac

if command -v jj >/dev/null 2>&1 && jj root >/dev/null 2>&1; then
  cd "$(jj root)"
  GIT_DIR="$(jj git root)"
  export GIT_DIR
  target=$(jj log --no-graph --no-pager -r 'heads(::@ ~ empty())' -T commit_id)
else
  cd "$(git rev-parse --show-toplevel)"
  target=$(git rev-list --max-count=1 HEAD -- :/)
fi

if [ -z "$target" ]; then
  echo "No commit with changes to tag." >&2
  exit 1
fi

year=$(echo "$on" | cut -c3-4)
month=$(echo "$on" | cut -d- -f2 | sed 's/^0//')
last=$(git tag --list | grep -E "^$year\.$month\.[0-9]+$" | cut -d. -f3 | sort -n | tail -n 1)

if [ -z "$last" ]; then
  version="$year.$month.0"
else
  version="$year.$month.$((last + 1))"
fi

ci_state() {
  gh run list --repo aaronmallen/aaronmallen.me --workflow ci.yml --commit "$target" --limit 1 \
    --json status,conclusion \
    --jq 'if length == 0 then "missing" elif .[0].status != "completed" then "running" elif .[0].conclusion == "success" then "passed" else "failed" end' \
    2>/dev/null || echo "unknown"
}

if [ -n "$dry_run" ]; then
  echo "$version"
  echo "$target"
  echo "CI $(ci_state)"
  last_tag=$(git tag --list --sort=-v:refname | grep -E '^[0-9]+\.[0-9]+\.[0-9]+$' | head -n 1)
  if [ -n "$last_tag" ]; then
    added=$(git diff "$last_tag" "$target" -- .env.example | awk '
      /^(\+\+\+|---) / { next }
      /^[+-](# )?[A-Z][A-Z0-9_]*=/ {
        name = $0
        sub(/^[+-](# )?/, "", name)
        sub(/=.*/, "", name)
        if (substr($0, 1, 1) == "-") { gone[name] = 1 } else if (!(name in seen)) { seen[name] = 1; order[++n] = name }
      }
      END { for (i = 1; i <= n; i++) if (!(order[i] in gone)) print "  " order[i] }')
    if [ -n "$added" ]; then
      echo "New in .env.example since $last_tag:"
      echo "$added"
    fi
  fi
  exit 0
fi

tagged=$(git tag --points-at "$target" | grep -E '^[0-9]+\.[0-9]+\.[0-9]+$' || true)
if [ -n "$tagged" ]; then
  echo "$target already carries $tagged." >&2
  exit 1
fi

if awk '/^## \[/ { open = ($0 ~ /^## \[Unreleased\]/); next } open && NF { found = 1 } END { exit !found }' CHANGELOG.md; then
  echo "CHANGELOG.md still has entries under [Unreleased]. Move them under $version first." >&2
  exit 1
fi

if ! grep -q "^## \[$version\]" CHANGELOG.md; then
  echo "CHANGELOG.md has no section for $version." >&2
  exit 1
fi

if ! grep -q "^\[Unreleased\]: .*/compare/$version\.\.\.HEAD$" CHANGELOG.md; then
  echo "CHANGELOG.md's [Unreleased] link does not compare from $version." >&2
  exit 1
fi

if ! grep -q "^\[$version\]: .*$version$" CHANGELOG.md; then
  echo "CHANGELOG.md has no compare link for $version." >&2
  exit 1
fi

if [ -n "$skip_ci" ]; then
  echo "Skipped the CI check on $target."
else
  case "$(ci_state)" in
  passed) ;;
  running)
    echo "CI is still running on $target. Wait for it to pass, or pass --skip-ci." >&2
    exit 1
    ;;
  failed)
    echo "CI did not pass on $target. Fix it, or pass --skip-ci." >&2
    exit 1
    ;;
  missing)
    echo "CI has not run on $target. Push it and wait for CI, or pass --skip-ci." >&2
    exit 1
    ;;
  *)
    echo "Could not read the CI state of $target from GitHub. Check gh, or pass --skip-ci." >&2
    exit 1
    ;;
  esac
fi

git -c tag.gpgSign=false tag --annotate --message "$version" "$version" "$target"
echo "Tagged $target as $version. Push it with:"
echo "git push origin $version"
